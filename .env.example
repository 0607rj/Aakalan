# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=development
# Defaults to ./data/app.db (SQLite). PostgreSQL later: postgresql+psycopg://user:pass@host/db
DATABASE_URL=
# DATA_DIR defaults to <repo>/data; set an absolute path to override (Docker uses /data)
# DATA_DIR=
SQLITE_VEC_ENABLED=true

# At least 32 characters. In production this comes from AWS Secrets Manager.
JWT_SECRET=change-me-to-a-long-random-string-0123456789
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]

# Password for the demo users created by `make seed` (development only)
SEED_USER_PASSWORD=aakalan-dev

# LLM (used from M3; tender text goes only to this provider)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
