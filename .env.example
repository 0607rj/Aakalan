# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=development
# Defaults to ./data/app.db (SQLite). PostgreSQL later: postgresql+psycopg://user:pass@host/db
DATABASE_URL=
# DATA_DIR defaults to <repo>/data; set an absolute path to override
# DATA_DIR=
SQLITE_VEC_ENABLED=true

# At least 32 characters. In production this comes from AWS Secrets Manager.
JWT_SECRET=change-me-to-a-long-random-string-0123456789
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]

# Sign-up and emailed 6-digit codes (verify email, reset password). Without SMTP_HOST the
# email (with its code) is written to the API server log instead: development only.
SIGNUP_ENABLED=true
OTP_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Aakalan <no-reply@aakalan.local>
SMTP_STARTTLS=true

# The first account `make seed` creates (it can do everything). Local use: any email and the
# example password are fine. On a server use an address you own (whoever reads that mailbox can
# reset the password) and a strong password: in production the seed refuses the example one.
# It is set only when the account is first created; change it later under Account.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=admin123
# Demo servers only: true lets that first account use a weak password in production
# (sign-ups keep their rules). Anyone who reads this public repo could then sign in as it.
SEED_ALLOW_WEAK_PASSWORD=false
# Sign-in emails of the product owner (a JSON list, e.g. ["you@yourcompany.com"]): they see
# every account (Admin page), the bid results, and publish rate cards. Use an address you own.
# Empty = nobody.
OWNER_EMAILS=[]

# LLM (used from M3; tender text goes only to this provider)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium
# Create a key at https://console.anthropic.com -> API keys, then paste it here (never commit .env)
ANTHROPIC_API_KEY=
# Web search tool for researching features the catalog lacks (only used with a key; see
# docs/OPEN_QUESTIONS.md 125). No key = no research: the catalog or the generic block prices them.
LLM_WEB_SEARCH_TOOL=web_search_20250305

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
